# Copy to .env and fill in. Never commit .env.

APP_NAME="AI Backend"
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
# LOG_JSON=true              # defaults to true outside "local"
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic API key from https://platform.claude.com (billed separately from claude.ai plans).
ANTHROPIC_API_KEY=

LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium            # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_STREAM_MAX_TOKENS=64000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_REFUSAL_FALLBACK=true

# Optional: vector DB for RAG modules (docker compose up qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
